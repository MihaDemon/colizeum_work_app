# Copy to .env and replace every placeholder. Never commit .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=work.example.com,localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://work.example.com
DJANGO_SECURE_COOKIES=True
POSTGRES_DB=colizeum
POSTGRES_USER=colizeum
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
TELEGRAM_BOT_TOKEN=replace-with-the-token-from-BotFather
BOT_SERVICE_TOKEN=replace-with-a-different-long-random-secret
WEBAPP_URL=https://work.example.com
# Internal gateway; host nginx proxies to this loopback port and terminates TLS.
GATEWAY_PORT=8000
# Local frontend development settings (also read from this root file).
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
DEV_ALLOWED_HOSTS=
# Optional: create the initial superuser once. Subsequent starts never change it.
OWNER_USERNAME=owner
OWNER_PASSWORD=replace-with-a-strong-owner-password
OWNER_EMAIL=
OWNER_TELEGRAM_ID=
